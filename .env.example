# ===================================================
# Agent Hub Decision Tree API Configuration (.env)
# ===================================================

# Database connection
# Default: zero-config SQLite database in ./data/decision_tree.db
DATABASE_URL=sqlite:///./data/decision_tree.db

# For Production (PostgreSQL with PgBouncer):
# DATABASE_URL=postgresql+psycopg://agent_hub:agent_hub@localhost:6432/decision_tree
# DIRECT_DATABASE_URL=postgresql+psycopg://agent_hub:agent_hub@localhost:5432/decision_tree
# DB_READ_URL=postgresql+psycopg://agent_hub:agent_hub@read-replica:5432/decision_tree

# Internal Service-to-Service API Key
# Callers (extraction, annotations, UI proxy) pass this via X-API-Key or Ocp-Apim-Subscription-Key
API_KEY=test-api-key

# Allowed CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# Authentication & Sessions
AUTH_PROVIDERS=["local"]
SESSION_SECRET=supersecret-session-key-change-in-production
SESSION_TTL_S=28800

# First-run admin credentials (if unset, a random password is generated and logged)
SEED_ADMIN_PASSWORD=admin

# Pre-seed demo customers, projects, and trees on startup
SEED_ON_START=true

# ML Model Catalog options
SUPPORTED_MODEL_TYPES=["azure_openai","openai","ollama"]
SEED_LOCAL_MODELS=true

# Server worker processes for Uvicorn
WEB_CONCURRENCY=4
